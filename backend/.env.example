# Clean Loop Environment Configuration Example
# Copy to backend/.env and adjust values

# Django Settings
SECRET_KEY=django-insecure-cleanloop-kochi-smart-waste-management-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Twilio Verify Settings (for Phone OTP authentication)
# Set OTP_DEV_MODE=True to bypass Twilio SMS in local dev (fixed OTP 123456)
OTP_DEV_MODE=True
TWILIO_ACCOUNT_SID=AC_dummy_twilio_account_sid
TWILIO_AUTH_TOKEN=dummy_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VA_dummy_twilio_verify_service_sid

# Razorpay Test Mode Settings
RAZORPAY_KEY_ID=rzp_test_cleanloop12345
RAZORPAY_KEY_SECRET=rzp_secret_dummy_test_key_67890
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret

# Google Gemini API
GEMINI_API_KEY=dummy_gemini_api_key_replace_with_real_key
GEMINI_MODEL=gemini-2.5-flash
AI_ENABLED=True

# Admin and Demo Customer Phones for Seed Data
ADMIN_PHONE=+919846012345
DEMO_CUSTOMER_PHONE=+919846098765
